    "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.5", "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0", "eslint": "^9.39.0", "tailwindcss": "^4.1.16",
