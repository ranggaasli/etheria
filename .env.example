PORT=3000
PUBLIC_URL=http://localhost:3000
# Default local mode uses SQLite + scrypt accounts; prohibited in production.
AUTH_MODE=local
SQLITE_PATH=data/etheria.sqlite
# Production: set AUTH_MODE=supabase and all three variables below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
# Optional trusted root CA file for PostgreSQL, otherwise system certificate roots.
PG_CA_FILE=
